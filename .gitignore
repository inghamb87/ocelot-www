# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Firebase config (project root, copied into ios/android by prebuild)
GoogleService-Info.plist
google-services.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by prebuild).
# ANCHORED with a leading slash on purpose. An unanchored `ios/` matches a
# directory of that name at ANY depth, which silently swallows
# modules/watch-bridge/ios/: hand written native source, not generated
# output. Without the anchor the phone side of the watch bridge is missing
# from the repo entirely, and because requireOptionalNativeModule degrades
# to no-ops a fresh clone fails silently rather than loudly. Local Expo
# modules keep their native code under modules/*/ios/, so any future one
# would hit the same trap.
/ios/
/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.staging
.env.production
# Written by __tests__/rpc/global-setup.ts from `supabase status` —
# not a secret on a local dev stack, but hygiene matters.
.env.local.test

# Supabase
supabase/.env
supabase/.temp/

# typescript
*.tsbuildinfo

app-example

# Generated by `expo prebuild` from assets/images/icon.png via the `icon`
# field in targets/watch/expo-target.config.js: a build product, not source.
# targets/ is a source dir (unlike ios/, which is ignored wholesale), so the
# generated subfolders are ignored one by one.
targets/watch/Assets.xcassets/AppIcon.appiconset/
# Same story: generated from assets/images/pickleball.png by the `images`
# map in expo-target.config.js.
targets/watch/Assets.xcassets/pickleball.imageset/

# Scratch files moved aside (delete when ready)
_to_delete/
