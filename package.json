{
  "name": "onyx-www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "preview": "npm run build && wrangler pages dev out --compatibility-date=2026-01-01",
    "deploy": "npm run build && wrangler pages deploy out",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "npm run typecheck && npm run check:contrast && npm run check:copy"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
