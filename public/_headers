# Static assets that bypass Pages Functions (see _routes.json).
# Pages and API responses get their headers from functions/_middleware.ts.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin

/favicon.svg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/og.png
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
